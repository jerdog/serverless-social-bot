# Cloudflare deploy credentials for ONE account (a "profile").
#
# Copy this to .cloudflare/<profile>.env (that directory is git-ignored), one
# file per Cloudflare account you deploy to:
#
#   mkdir -p .cloudflare
#   cp .cloudflare.env.example .cloudflare/default.env      # your main account
#   cp .cloudflare.env.example .cloudflare/personal.env     # another account
#
# Then deploy with:  scripts/deploy.sh [profile]
#
# - API token: create at https://dash.cloudflare.com/profile/api-tokens using the
#   "Edit Cloudflare Workers" template, scoped to the target account. It needs
#   Workers Scripts + Workers KV + Workers AI edit permissions.
# - Account ID: shown on that account's dashboard overview page (right sidebar),
#   or run `npx wrangler whoami` once logged in.

CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
